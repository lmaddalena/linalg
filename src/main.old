#include "../include/linalg.h"
#include <stdlib.h>
#include <stdarg.h>
#include <stdio.h>
#include <time.h>

double sum(double d)
{
    return d+1;
}

double power(double d)
{
    return d*d;
}

int main(int argc, char *argv[])
{    
   
   	printf("Hello World!!\n");

    t_LinAlg la = LinAlg_Init();
    
    double data[6] = {1, 2, 3, 4, 5, 6};
    t_matrix mmm = la.matrixd(data, 2,3);
    la.print(mmm);

    la.free(mmm);

    t_matrix m = la.matrix(1000, 1000);

    for(int i = 0; i < m.size; i++)
        m.data[i] = i/1000;

    la.print(m);
    printf("---------------\n");

    clock_t start, end;
    double elapsed;

    start = clock();

    t_matrix m2 = la.dot(m, m);
    end = clock();
    elapsed = (double)(end - start) / (double)CLOCKS_PER_SEC;

    la.print(m2);

    printf("\n");

    printf("dot matrix ends in %.4f mils\n", elapsed * 1000);
    
    t_matrix m3 = la.T(m2);
    la.print(m3);

    printf("\nslice rows:\n");
    printf("----------------------------------------\n");
    t_matrix m4 = la.slice_rows(m, 2, 5);
    la.print(m4);

    printf("\nslice cols:\n");
    printf("----------------------------------------\n");
    t_matrix m5 = la.slice_cols(m, 2, 5);
    la.print(m5);


    la.frees(5, m, m2, m3, m4, m5);

    t_matrix id = la.identity(5);
    la.print(id);
    la.free(id);
    
    t_matrix random = la.rand(10,10, 1, 100);
    la.print(random);
    la.free(random);

    t_matrix a = la.matrix(2, 2);
    la.setval(a, 0, 0, 1);
    la.setval(a, 0, 1, 2);
    la.setval(a, 1, 0, 3);
    la.setval(a, 1, 1, 4);
    la.print(a);
    printf("\n");

    la.apply(a, power);

    la.print(a);
    printf("\n");

    t_matrix b = la.matrix(2, 3);
    la.setval(b, 0, 0, 1);
    la.setval(b, 0, 1, 2);
    la.setval(b, 0, 2, 3);
    la.setval(b, 1, 0, 4);
    la.setval(b, 1, 1, 5);
    la.setval(b, 1, 2, 6);
    la.print(b);
    printf("\n");

    printf("column sum:\n");
    t_matrix colsum = la.sum_cols(b);
    la.print(colsum);
    printf("\n");

    printf("row sum:\n");
    t_matrix rowsum = la.sum_rows(b);
    la.print(rowsum);
    printf("\n");

    t_matrix c = la.dot(a,b);
    la.print(c);
    
    t_matrix d = la.matrix(3,1);
    la.setval(d, 0, 0, 1);
    la.setval(d, 1, 0, 2);
    la.setval(d, 2, 0, 3);

    t_matrix e = la.matrix(1,3);
    la.setval(e, 0, 0, 1);
    la.setval(e, 0, 1, 2);
    la.setval(e, 0, 2, 3);

    t_matrix f = la.dot(e, d);
    la.print(f);

    la.frees(8, a, b, c, d, e, f, rowsum, colsum);

    return EXIT_SUCCESS;
}

